# ─── Database ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI.
# Use the SESSION POOLER string (port 5432), not the transaction pooler —
# Payload's migrations need session-level features that pgbouncer's
# transaction mode does not support.
DATABASE_URI=

# ─── Payload ─────────────────────────────────────────────────────────────────
# Signs admin session cookies. Any random string, 32+ chars.
# Generate with:  openssl rand -base64 32
PAYLOAD_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin. Used for canonical URLs, sitemap entries, OG tags and
# JSON-LD publisher data. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Storage ─────────────────────────────────────────────────────────────────
# Vercel → Storage → Blob → create store → copy the read/write token.
# Leave empty locally: uploads then fall back to the filesystem.
BLOB_READ_WRITE_TOKEN=

# ─── AI identification (optional) ─────────────────────────────────────────────
# Enables `pnpm identify <lookId>` — pre-fills the review queue by detecting
# garments in a look's photograph. Without it the manual workflow is unaffected.
ANTHROPIC_API_KEY=
