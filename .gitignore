# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials, but the documented template must
# survive so a fresh clone knows what to fill in.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling artifacts
.playwright-mcp/
*.local.jpeg

# affiliate feeds — real ones carry tracking URLs and get large
/feeds/*
!/feeds/sample.csv

# Payload uploads — regenerate with `pnpm seed:portraits`, or use Vercel Blob in prod
/media
